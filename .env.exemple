# Live mesh map (world edition) — minimal configuration.
# Everything else is set from the map (setup wizard, then Settings). Variable names are kept from the French edition.

# Setup code (optional): asked to create the admin account.
# Left empty: no code from the local network; from elsewhere (remote server, reverse proxy, Tailscale…),
# a random code is drawn and shown in the server log:
#   docker compose logs carte-live | grep -i installation
ADMIN_MOT_DE_PASSE=

# Map port on the machine
CARTE_PORT=8095

# Area of the map (can also be chosen in the wizard).
# Outside France: a 1° × 1° square named after its south-west corner, e.g. MN40W075 = 40–41°N, 75–74°W
# (terrain: Copernicus DEM GLO-30). In France: a department number (43, 2A…) with IGN terrain.
DEPARTEMENT=MN40W075
# ZONE_NOM=New Jersey
# ZONE_BBOX=south,west,north,east   (optional, otherwise the 1° square)

# Radio frequency used for coverage computations, in MHz:
# 906.875 (US LongFast), 869.525 (EU_868), 919.875 (ANZ), 923.875 (AS923)…
RADIO_FREQ_MHZ=906.875
# Network preset (airtime) if the radio node didn't report it
RESEAU_PRESET=LONG_FAST

# Default display (each visitor can change base map and layers; their choice is kept)
# Base map: dark, map, dark-map, photos or topo (map/photos are French IGN maps; French values also work)
CARTE_FOND=dark
# Networks offered: both, meshtastic or meshcore
CARTE_RESEAUX=both
# Layers hidden at start, comma-separated: sommets (high points and suggested sites),
# routiers, rf, voisinage, traceroute, animations, federation, releves
CARTE_COUCHES_MASQUEES=routiers

# MQTT broker (can be changed in the wizard)
MQTT_URL=mqtt://mqtt.example.org:1883
MQTT_UTILISATEUR=
MQTT_MOT_DE_PASSE=
MQTT_RACINE=msh/US

# Channels to decrypt: name=key (AQ== = default public key), separated by ;
CANAUX=LongFast=AQ==

# MeshCore (map, packet analyser, companion observer)
# MESHCORE=no to disable; meshcoretomqtt topic format: ROOT/IATA/KEY/packets
MESHCORE=yes
MESHCORE_RACINE=meshcore
# Area code (nearest airport, IATA), e.g. PHL
MESHCORE_IATA=PHL
MESHCORE_REPUBLIER=yes
# Channels to decrypt: Public ; #name (hashtag channel) ; name=secret (32 hex characters)
MESHCORE_CANAUX=Public
# Expected companion radio setting: frequency,bandwidth,SF,CR ; « no »: no warning
MESHCORE_RADIO_ATTENDUE=no
# Extra MeshCore regions to recognise in messages
MESHCORE_REGIONS=
# Repeater silent after (hours); repeater status queried every N hours (0 = never), max N per round
MESHCORE_MUET_HEURES=26
# MeshCore packets and receptions kept N days
MESHCORE_RETENTION_PAQUETS_JOURS=2
# MeshCore packets kept: area (the map area), neighbours (area + surroundings) or national (everything, heavy)
MESHCORE_PERIMETRE=neighbours
# Area codes accepted for observers without position (e.g. EWR,JFK)
MESHCORE_IATA_VOISINS=
# Exports (GeoJSON, GPX, Prometheus /metrics, Home Assistant): if set, ?jeton=… is required
EXPORT_JETON=
MESHCORE_SUPERVISION_HEURES=3
MESHCORE_SUPERVISION_MAX=8

# Meshtastic node over Wi-Fi (optional, also settable from the map: Network › Radio nodes)
RADIO_HOTE=
RADIO_PORT=4403

# mqtts:// or wss:// with a self-signed certificate only: disables certificate checking (not recommended)
# MQTT_TLS_NON_VERIFIE=yes
# Reverse proxies allowed to pass the visitor's address (default: local addresses)
# PROXY_CONFIANCE=loopback, linklocal, uniquelocal

# PostgreSQL archive (optional): all traffic copied without time limit (Grafana, SQL queries…).
# With the provided container: docker compose --profile postgres up -d
# POSTGRES_MOT_DE_PASSE=a-long-password
# POSTGRES_URL=postgres://carte:a-long-password@postgres:5432/carte

# Meshtastic ⇄ MeshCore bridge (channel messages, auxiliary tool): an administrator enables it
# in Tools › ⇄ Cross-network bridge. PASSERELLE=1: enabled at first start; PASSERELLE=0: forbidden.
# PASSERELLE=1

# Copernicus DEM mirror (optional)
# COPERNICUS_URL=https://copernicus-dem-30m.s3.amazonaws.com

# Server log language (docker compose logs): en or fr. The interface follows each browser's language.
LANGUE=en
# Values in this file can be written in English or French (yes/oui, no/non, dark/sombre, both/les-deux…).

# MeshCore links deduced from paths: minimum hash size (1, 2 or 3 bytes; 1 byte = ambiguous prefixes)
MESHCORE_LIENS_OCTETS_MIN=2

# Features hidden for every user (can be changed later in Settings › Displayed features):
# signalements (reports), vigipirate, fr-alert, main-courante (log book), bipper, feux (active fires).
# The French alert features (Vigipirate, FR-Alert, Bipper) are of no use outside France:
FONCTIONS_MASQUEES=vigipirate,fr-alert,bipper

# Active fires: NASA FIRMS is read without an account (worldwide). Meteosat (every 15 min, Europe and Africa)
# needs a free LSA SAF account: https://mokey.lsasvcs.ipma.pt/auth/signup
LSASAF_UTILISATEUR=
LSASAF_MOT_DE_PASSE=
